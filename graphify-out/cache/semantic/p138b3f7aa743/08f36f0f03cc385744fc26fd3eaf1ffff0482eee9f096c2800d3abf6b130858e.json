{"nodes": [{"id": "paper_v4_extracted_text_multicardiofusion", "label": "MultiCardioFusion Framework", "file_type": "paper", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fuses clinical features with ECG features because unimodal models lack clinical context; interpretable pipeline for auditability. Soft-voting reaches AUC 0.9535, acc 88.52%, recall 92.86% (+7.04pp over clinical-only)."}, {"id": "paper_v4_extracted_text_mcf_bimodnet", "label": "MCF-BiModNet Algorithm", "file_type": "rationale", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dual-branch Dense(64)->BN->Dropout(0.4)->Dense(32) per modality, cross-attention fusion, SMOTE, soft voting, TreeSHAP output."}, {"id": "paper_v4_extracted_text_cross_attention_fusion", "label": "Cross-Attention Fusion (ECG query, clinical key/value)", "file_type": "rationale", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keras MultiHeadAttention 4 heads, key_dim 8; residual h_fuse = MultiHead + h_ecg preserves gradient flow and prevents ECG branch being displaced."}, {"id": "paper_v4_extracted_text_soft_voting_ensemble", "label": "Soft-Voting Ensemble (XGB+SVM+GBM+RF)", "file_type": "rationale", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Averages class probabilities; preferred over hard voting since it uses classifier confidence and reduces variance on small, miscalibrated datasets."}, {"id": "paper_v4_extracted_text_feature_level_fusion", "label": "Feature-Level Concatenation Fusion", "file_type": "rationale", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_v4_extracted_text_ecg_proxy_features", "label": "ECG-Proxy Feature Engineering", "file_type": "rationale", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived from Cleveland's own restecg, oldpeak, slope, thalach, exang (polynomial, interaction, log, ratio terms -> 23 columns) to sidestep cross-cohort label misalignment with PTB-XL."}, {"id": "paper_v4_extracted_text_dataset_d1", "label": "D1 Clinical-Only Dataset (303x13)", "file_type": "concept", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_v4_extracted_text_dataset_d2", "label": "D2 PTB-XL tsfresh Dataset (303x568)", "file_type": "concept", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_v4_extracted_text_dataset_d3", "label": "D3 Aligned Multimodal Matrix (303x36)", "file_type": "concept", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_v4_extracted_text_uci_cleveland_dataset", "label": "UCI Cleveland Heart Disease Dataset", "file_type": "document", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loaded via ucimlrepo API (ID 45) to avoid CSV manual errors; binarized num>0; median imputation for ordinal ca/thal."}, {"id": "paper_v4_extracted_text_ptb_xl_dataset", "label": "PTB-XL ECG Dataset", "file_type": "document", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "21,837 12-lead 10s recordings; stratified sample of 303 (126 normal, 177 abnormal), SEED=42."}, {"id": "paper_v4_extracted_text_lead_ii", "label": "Lead-II ECG Channel", "file_type": "concept", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aligned with heart's mean electrical axis; P-wave and QRS most legible; first lead clinicians consult. Limitation: misses abnormalities visible in other leads."}, {"id": "paper_v4_extracted_text_tsfresh", "label": "tsfresh Feature Extraction", "file_type": "concept", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EfficientFCParameters yields 777 features; VarianceThreshold(0.01) keeps 568."}, {"id": "paper_v4_extracted_text_variance_threshold", "label": "VarianceThreshold Filter", "file_type": "concept", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_v4_extracted_text_standardscaler", "label": "StandardScaler Standardisation", "file_type": "concept", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_v4_extracted_text_smote", "label": "SMOTE Oversampling", "file_type": "concept", "source_file": "paper/v4_extracted_text.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applied only after 80/20 split to training partition to avoid data leakage; interpolation stays on the data manifold. Largest ablation drop when removed."}, {"id": "paper_v4_extracted_text_treeshap", "label": "TreeSHAP / SHAP Explainability", "file_type": "concept", "source_file": "paper/v4_extra